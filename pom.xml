<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.rongfengliang</groupId>
    <artifactId>nats-rpc-framework</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <modules>
        <module>nats-rpc-core</module>
        <module>nats-rpc-springboot-starter</module>
        <module>nats-rpc-springboot-starter-webmvc</module>
        <module>nats-rpc-springboot-starter-webmvc-springdoc</module>
        <module>nats-rpc-springboot-starter-apigateway</module>
        <module>nats-rpc-springboot-starter-webflux</module>
        <module>nats-rpc-springboot-starter-webflux-springdoc</module>
        <module>nats-rpc-springboot-starter-apigateway-webflux</module>
        <module>nats-rpc-core-reactor</module>
        <module>nats-rpc-core-reactor-resilience4j</module>
        <module>nats-rpc-resilience4j</module>
        <module>samples</module>
        <module>samples/rpc-server</module>
        <module>samples/rpc-common</module>
        <module>samples/rpc-client</module>
    </modules>

    <properties>
        <revision>1.0.6+3.5-SNAPSHOT</revision>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jnats.version>2.24.1</jnats.version>
        <jackson.version>2.20.1</jackson.version>
        <lombok.version>1.18.42</lombok.version>
        <slf4j.version>2.0.9</slf4j.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <spring.boot.version>3.5.16</spring.boot.version>
        <rector.version>3.8.2</rector.version>
        <common.lang3.version>3.20.0</common.lang3.version>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.3</version>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>generate-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>xcmg</id>
            <properties>
                <docker.registry>10.16.10.28:8086/irmp/</docker.registry>
            </properties>
            <distributionManagement>
                <repository>
                    <id>xgzl-irmp-rel</id>
                    <name>xgzl-irmp-rel</name>
                    <url>http://10.16.10.28:8081/repository/irmp-rel/</url>
                </repository>
                <snapshotRepository>
                    <id>xgzl-irmp-sns</id>
                    <name>xgzl-irmp-sns</name>
                    <url>http://10.16.10.28:8081/repository/irmp-sns/</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>

</project>